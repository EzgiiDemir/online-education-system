# eCenter — production environment template.
#
# Copy to .env on the production server, fill the four <PLACEHOLDER> secrets,
# then run `php artisan key:generate` (once only — regenerating APP_KEY later
# makes every existing session and every encrypted value unreadable).
#
# Nothing in this file is a secret. Never commit the filled-in .env.

APP_NAME=eCenter
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://ecenter.arucad.edu.tr

# The UI is Turkish-first and switches per user; these are the framework
# fallbacks used where no user locale applies (queue workers, CLI, validation).
APP_LOCALE=tr
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=tr_TR
APP_TIMEZONE=Europe/Istanbul

APP_MAINTENANCE_DRIVER=file

# 'warning' keeps routine request noise out of production logs while still
# recording anything that actually needs attention. daily + 14 files gives
# two weeks of history with built-in rotation (see LOG ROTATION in the
# infrastructure handoff).
LOG_CHANNEL=stack
LOG_STACK=daily
LOG_DAILY_DAYS=14
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=warning

# --- Database ---------------------------------------------------------------
# PostgreSQL is required: the schema uses jsonb, ILIKE and CHECK-constraint
# enums. The application user needs DDL rights on this database only
# (migrations run as it); it does not need superuser.
DB_CONNECTION=pgsql
DB_HOST=<DB_HOST>
DB_PORT=5432
DB_DATABASE=ecenter
DB_USERNAME=ecenter
DB_PASSWORD=<DB_PASSWORD>

# --- Session / cache / queue ------------------------------------------------
# All three are database-backed, so no Redis/Memcached server is required.
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
# Cookies must never travel over plain http in production.
SESSION_SECURE_COOKIE=true
SESSION_SAME_SITE=lax

CACHE_STORE=database
QUEUE_CONNECTION=database
FILESYSTEM_DISK=local
BROADCAST_CONNECTION=log

# --- Reverse proxy ----------------------------------------------------------
# Set ONLY if a load balancer or reverse proxy terminates TLS in front of the
# app. Comma-separated proxy IPs, or "*" when the app is reachable exclusively
# through that proxy. Left empty the app trusts no proxy, which is correct
# when the web server faces users directly.
TRUSTED_PROXIES=

# --- Mail -------------------------------------------------------------------
# Microsoft 365 SMTP relay. MAIL_PASSWORD is a secret: keep it here on the
# server only, never in Git. SMTP AUTH must be enabled for this mailbox in the
# Microsoft 365 tenant (see the infrastructure handoff).
MAIL_MAILER=smtp
MAIL_HOST=smtp.office365.com
MAIL_PORT=587
MAIL_SCHEME=smtp
MAIL_ENCRYPTION=tls
MAIL_USERNAME=support@arucad.edu.tr
MAIL_PASSWORD=<SMTP_PASSWORD>
MAIL_FROM_ADDRESS=support@arucad.edu.tr
MAIL_FROM_NAME=eCenter

# --- Microsoft Entra ID SSO -------------------------------------------------
# Optional. Portal Settings in the admin panel switches SSO on; these values
# come from the Azure app registration. Leave blank if SSO is not used.
ENTRA_TENANT_ID=
ENTRA_CLIENT_ID=
ENTRA_CLIENT_SECRET=
ENTRA_REDIRECT_URI=https://ecenter.arucad.edu.tr/auth/entra/callback

VITE_APP_NAME="${APP_NAME}"
