# /etc/cron.d/ecenter -- installed by deploy/server-setup.sh.
#
# Laravel's official recommended way to run the scheduler on a traditional
# VPS: one cron entry that fires every minute and lets the framework decide
# what actually needs to run. Everything recurring lives in bootstrap/app.php
# (->withSchedule) and shows on the admin System Health page:
#   02:30 nightly backup (deploy/backup.sh, keeps 14 days on this disk)
#   03:00 purge expired recordings
#   04:00 prune old failed jobs, 04:10 clear expired password reset links
#   07:00 training reminders
#
# The local backups are not disaster recovery: the infrastructure team must
# also copy storage/app/backups off the server (encrypted) -- see
# SUNUCU_TEKNIK_GEREKSINIMLERI.md section 8.
#
# On a Procfile-based platform (Heroku/Railway/Render), use the "scheduler"
# process from ./Procfile (`php artisan schedule:work`) instead.

SHELL=/bin/bash
PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin

* * * * *  www-data  cd /var/www/ecenter/current && php artisan schedule:run >> /dev/null 2>&1
